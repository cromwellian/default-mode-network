# DMN environment — copy to .env and fill in values.
# Load into Modal: ./scripts/modal_secrets_setup.sh

# --- LLM (pick one provider) ---
DMN_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DMN_LLM_MODEL=claude-sonnet-4-5-20250929

# --- Local / vLLM on Modal (when using llm.provider=vllm in API requests) ---
# DMN_LLM_PROVIDER=vllm
# DMN_LLM_BASE_URL=http://localhost:8000/v1
# DMN_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# HuggingFace token — required for gated models (Gemma, etc.) on Modal vLLM
# HF_TOKEN=
# HUGGINGFACE_TOKEN=

# --- Embeddings ---
DMN_EMBEDDINGS=st

# --- Optional generative media (research --generate) ---
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# REPLICATE_API_TOKEN=
# HF_TOKEN=

# --- Optional tools ---
# YOUTUBE_API_KEY=
