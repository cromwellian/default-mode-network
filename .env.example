# DMN environment — copy to .env and fill in what you use. `uv run dmn-setup` writes
# this for you. All entry points load .env automatically; it's gitignored.
# For Modal deploys, load it into a secret with: ./scripts/modal_secrets_setup.sh

# --- LLM: the simplest working setup is just an Anthropic key ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Force a provider instead of auto-pick (anthropic → openai → stub):
# DMN_LLM_PROVIDER=anthropic | openai | ollama | lmstudio | vllm | stub
# Override the model for whichever provider is active:
# DMN_LLM_MODEL=claude-sonnet-4-6
# Local/OpenAI-compatible servers (ollama/lmstudio/vllm) — custom endpoint:
# DMN_LLM_BASE_URL=http://localhost:11434/v1

# --- Embeddings: st (local sentence-transformers; needs `uv sync --extra embeddings`),
#     openai (uses OPENAI_API_KEY), or hash (no-dependency fallback). Default: st,
#     degrading to hash when sentence-transformers isn't installed.
# DMN_EMBEDDINGS=st

# --- Optional generative media (image/music/video riffs) ---
# GOOGLE_API_KEY=          # Gemini image (nano-banana); GEMINI_API_KEY also works
# GEMINI_API_KEY=
# REPLICATE_API_TOKEN=     # image/video fallbacks
# STABILITY_API_KEY=       # Stable Audio 2.0 music
# SUNO_API_KEY=            # music (stub until upstream API is public)
# RUN_API_KEY=             # Runway text-to-video (RUNWAYML_API_SECRET / RUNWAY_API_KEY also work)
# HF_TOKEN=                # HuggingFace: gated models on Modal vLLM + HF image backends
# DMN_ENABLE_VIDEO_RIFFS=0
# DMN_VIDEO_RUNWAY_MODEL=seedance2
# DMN_VIDEO_SECONDS=10
# DMN_IMAGE_ALLOW_FALLBACKS=0
# More overrides (model ids per backend, video timeouts/ratio, VLLM_MODEL,
# HF token aliases): see docs/tuning.md

# --- Optional search tools ---
# YOUTUBE_API_KEY=
